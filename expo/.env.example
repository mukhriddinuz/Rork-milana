# ── Client (safe to expose, bundled into the app) ──────────────
# Supabase project URL and anon/public key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Comma-separated emails granted admin UI access (UX gate only;
# real authorization is enforced by RLS via the profiles.role column).
EXPO_PUBLIC_ADMIN_EMAILS=founder@example.com

# ── Server only (Vercel env, NEVER prefixed EXPO_PUBLIC_) ──────
# Rork toolkit endpoint + secret used by /api/stylist. Keeping the
# secret server-side means it never reaches the browser bundle.
TOOLKIT_URL=https://toolkit.rork.com
RORK_TOOLKIT_SECRET_KEY=your-server-side-secret

# Optional: comma-separated origins allowed to call /api/stylist.
# Leave unset to allow all origins.
STYLIST_ALLOWED_ORIGINS=https://your-site.com
